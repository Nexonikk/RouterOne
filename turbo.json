{
    "$schema": "https://turborepo.dev/schema.json",
    "ui": "tui",
    "globalEnv": [
        "DATABASE_URL",
        "JWT_SECRET",
        "MJ_APIKEY_PUBLIC",
        "MJ_APIKEY_PRIVATE",
        "FRONTEND_URL",
        "RESEND_API_KEY",
        "BREVO_API_KEY"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "check-types": {
            "dependsOn": ["^check-types"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
